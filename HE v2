local currentPreset = UIConfig.CurrentTheme or "Cyan & Orange"

local function createManagedGradient(rot)
   local g = Instance.new("UIGradient")
   g.Color = ColorPresets[currentPreset].sequence
   g.Rotation = rot or 0
   table.insert(registeredGradients, g)
   return g
end

local function applyTheme(key)
   if not ColorPresets[key] then return end
   currentPreset = key
   UIConfig.CurrentTheme = key
   SaveConfig()
   local seq = ColorPresets[key].sequence
   for _, grad in ipairs(registeredGradients) do
      if grad and grad.Parent then grad.Color = seq end
   end
end

