local isOpen, isTweening = true, false
local function setUIVisibility(v)
   if isTweening then return end
   isTweening = true
   if v then
      mainFrame.Visible = true
      mainFrame.Size = UDim2.new(0.6, 0, 0.5, 0)
      local t = TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0.85, 0, 0.75, 0)})
      t:Play() t.Completed:Wait()
      isOpen = true
   else
      local t = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Size = UDim2.new(0.5, 0, 0.4, 0)})
      t:Play() t.Completed:Wait()
      mainFrame.Visible = false
      isOpen = false
   end
   isTweening = false
end

