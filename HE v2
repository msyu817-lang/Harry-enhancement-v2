      self:StopAutoFire()
   end
   print("[Harry] Ragebot LIMIT:", state and "ON" or "OFF")
end

function SilentAim:Setup()
   if not GunModule or self.OriginalStartShooting then return end
   self.OriginalStartShooting = GunModule.StartShooting

   self.HeartbeatConnection = RunService.Heartbeat:Connect(function()
      if self.Active then
         self.TargetPlayer = self:FindClosestEnemy()
      end
   end)

   GunModule.StartShooting = function(ctx, ...)
      local res = {self.OriginalStartShooting(ctx, ...)}
      if not ctx.ClientFighter or not ctx.ClientFighter.IsLocalPlayer then
         return unpack(res)
      end

      local bullet = res[3]
      if type(bullet) ~= "table" then
         return unpack(res)
      end

      res[4] = true

      local target = self.TargetPlayer
      if not self.Active or not target or not target.Character or self:IsImmune(target) then
         return unpack(res)
      end

      if not self.IsDesyncing or self.CurrentTarget ~= target then
         self:StartDesync(target)
         task.wait(0.025)
      end

      if self.ResetTask then
         task.cancel(self.ResetTask)
      end

      local head = target.Character:FindFirstChild("Head")
      local root = target.Character:FindFirstChild("HumanoidRootPart")
      if not head then return unpack(res) end

      local hp = head.Position

      if root then
         local ping = 80
         pcall(function()
            ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
         end)
         hp = hp + root.AssemblyLinearVelocity * (ping / 1000 * 2.1)
      end

      hp = hp + Vector3.new(0, 0.2, 0)
      local origin = hp - Vector3.new(0, 4.2, 0)
      local look = CFrame.lookAt(origin, hp)

      if UtilityModule and UtilityModule.EncodeCFrame then
         bullet[utf8.char(0)] = UtilityModule:EncodeCFrame(CFrame.new(origin, hp) * CFrame.Angles(look:ToOrientation()))
         bullet[utf8.char(1)] = UtilityModule:EncodeCFrame(CFrame.new(hp) * CFrame.Angles(look:ToOrientation()))
         bullet[utf8.char(2)] = head

         local multiOffsets = {
            Vector3.new(0.35, 0.15, 0),
            Vector3.new(-0.35, 0.15, 0),
            Vector3.new(0, 0.45, 0),
            Vector3.new(0.25, -0.15, 0.2),
            Vector3.new(-0.25, -0.15, -0.2),
            Vector3.new(0.4, 0.05, 0.15),
            Vector3.new(-0.4, 0.05, -0.15),
            Vector3.new(0, 0.3, 0.25),
         }

         for i, off in ipairs(multiOffsets) do
            bullet[utf8.char(3 + i)] = UtilityModule:EncodeCFrame(CFrame.new(hp + off))
         end
      end

      if UIConfig.BulletTracer then
         HarryCreateTracer(Camera.CFrame.Position, hp)
      end

      self.ResetTask = task.delay(0.14, function()
         self:StopDesync()
      end)

      return unpack(res)
   end
end

