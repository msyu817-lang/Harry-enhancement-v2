function SilentAim:IsImmune(target)
   if not target or not target.Character then return true end
   local char = target.Character
   local hum = char:FindFirstChildOfClass("Humanoid")
   if not hum or hum.Health <= 0 then return true end
   if char:FindFirstChild("ForceField") then return true end
   if char:GetAttribute("Immune") or char:GetAttribute("Invincible") then return true end
   if hum:GetAttribute("Immune") then return true end
   local status = char:FindFirstChild("Status") or char:FindFirstChild("Effects")
   if status and (status:FindFirstChild("Immune") or status:FindFirstChild("Invulnerable")) then return true end
   return false
end

function SilentAim:FindClosestEnemy()
   local myRoot = LocalCharacterParts.Root
   if not myRoot then return nil end
   local best, bestScore = nil, -math.huge
   for _, p in ipairs(Players:GetPlayers()) do
      if p ~= player and p:GetAttribute("TeamID") ~= player:GetAttribute("TeamID") then
         local char = p.Character
         if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if root and head and hum and hum.Health > 0 and not self:IsImmune(p) then
               local dist = (myRoot.Position - root.Position).Magnitude
               if dist <= 320 then
                  local score = (320 - dist) + ((100 - hum.Health) * 2.4)
                  if score > bestScore then
                     bestScore = score
                     best = p
                  end
               end
            end
         end
      end
   end
   return best
end

function SilentAim:StartDesync(target)
   if self.DesyncConnection then self.DesyncConnection:Disconnect() end
   self.IsDesyncing = true
   self.CurrentTarget = target

   local offsets = {
      CFrame.new(0, -12, 0),
      CFrame.new(0, -10, 6),
      CFrame.new(0, -10, -6),
      CFrame.new(8, -11, 0),
      CFrame.new(-8, -11, 0),
      CFrame.new(0, -14, 3),
      CFrame.new(5, -13, 4),
      CFrame.new(-5, -13, -4),
      CFrame.new(0, -9, 8),
      CFrame.new(0, -15, 0),
   }
   local off = offsets[math.random(1, #offsets)]

   self.DesyncConnection = RunService.Heartbeat:Connect(function()
      if not self.IsDesyncing then return end
      local myRoot = LocalCharacterParts.Root
      local tRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
      if not myRoot or not tRoot then self:StopDesync() return end

      local old = myRoot.CFrame
      local vel = myRoot.AssemblyLinearVelocity
      local rot = myRoot.AssemblyAngularVelocity

      myRoot.CFrame = tRoot.CFrame * off

      RunService:BindToRenderStep("harry_limit", 100, function()
         myRoot.CFrame = old
         myRoot.AssemblyLinearVelocity = vel
         myRoot.AssemblyAngularVelocity = rot
         RunService:UnbindFromRenderStep("harry_limit")
      end)
   end)
end

function SilentAim:StopDesync()
   self.IsDesyncing = false
   self.CurrentTarget = nil
   if self.DesyncConnection then
      self.DesyncConnection:Disconnect()
      self.DesyncConnection = nil
   end
end

function SilentAim:StartAutoFire()
   if self.AutoFireConn then return end
   self.AutoFireConn = RunService.Heartbeat:Connect(function()
      if not self.Active then return end
      if not self.TargetPlayer or self:IsImmune(self.TargetPlayer) then return end
      local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
      if not hum or hum.Health <= 0 then return end

      VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
      task.wait(0.004)
      VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
      task.wait(0.012)
   end)
end

function SilentAim:StopAutoFire()
   if self.AutoFireConn then
      self.AutoFireConn:Disconnect()
      self.AutoFireConn = nil
   end
end

function SilentAim:Toggle(state)
   self.Active = state
   if state then
      self:StartAutoFire()
   else
