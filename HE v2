local topL = createCrossLine(UDim2.new(0, 2, 0, 10), UDim2.new(0, 0, 0, -8))
local botL = createCrossLine(UDim2.new(0, 2, 0, 10), UDim2.new(0, 0, 0, 8))
local leftL = createCrossLine(UDim2.new(0, 10, 0, 2), UDim2.new(0, -8, 0, 0))
local rightL = createCrossLine(UDim2.new(0, 10, 0, 2), UDim2.new(0, 8, 0, 0))
local crossLines = {topL, botL, leftL, rightL}

local spinAngle, pulseTime = 0, 0
RunService.RenderStepped:Connect(function(dt)
   if not UIConfig.Crosshair_Enabled then
      crosshairCenter.Visible = false
      return
   end
   crosshairCenter.Visible = true
   local col = UIConfig.Crosshair_Rainbow and Color3.fromHSV((tick() % 4) / 4, 1, 1) or Color3.fromRGB(UIConfig.Crosshair_R, UIConfig.Crosshair_G, UIConfig.Crosshair_B)
   for _, l in ipairs(crossLines) do l.BackgroundColor3 = col end
   if UIConfig.Crosshair_Spin then
      spinAngle = (spinAngle + dt * UIConfig.Crosshair_SpinSpeed * 60) % 360
      crosshairCenter.Rotation = spinAngle
   else
      crosshairCenter.Rotation = 0
   end
   local offset = 8
   if UIConfig.Crosshair_Pulse then
      pulseTime = pulseTime + dt * UIConfig.Crosshair_PulseSpeed * 1.5
      offset = 6 + (math.sin(pulseTime) + 1) * 6
   end
   topL.Position = UDim2.new(0, 0, 0, -offset)
   botL.Position = UDim2.new(0, 0, 0, offset)
   leftL.Position = UDim2.new(0, -offset, 0, 0)
   rightL.Position = UDim2.new(0, offset, 0, 0)
end)

